{% extends 'base.html.twig' %}
{% block title %}Admin | Tableau de Bord{% endblock %}
{% block body %}
<div class="dashboard-wrap">
    <div class="header-row">
        <h1 style="color:var(--neon-purple);">Panneau d'Administration</h1>
        <p style="color:var(--neon-blue); font-weight:bold; font-size:1.4em; margin:40px 0">Gérez les jeux et surveillez les inscriptions.</p>
    </div>

    <div class="cyber-card" style="width: 100%; max-width: 600px">
        <h2 style="color:var(--neon-purple); text-align:center; margin-bottom:12px;">Créer un nouveau jeu</h2>
        
        {{ form_start(form, {'attr': {'class':'cyber-form'}, 'novalidate': 'novalidate'}) }}
        <div class="form-field">
            {{ form_label(form.titre, 'Nom du jeu') }}
            {{ form_widget(form.titre, {'attr': {'class':'cyber-input'}}) }}
            {{ form_errors(form.titre) }}
        </div>
        <div class="form-field">
            {{ form_label(form.description, 'Description') }}
            {{ form_widget(form.description, {'attr': {'class':'cyber-input'}}) }}
            {{ form_errors(form.description) }}
        </div>
        <div class="form-field">
            {{ form_label(form.ville, 'Ville') }}
            {{ form_widget(form.ville, {'attr': {'class':'cyber-input'}}) }}
            {{ form_errors(form.ville) }}
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
            <div style="flex:1; min-width:140px;">
                <div class="form-field">
                    {{ form_label(form.latitude, 'Latitude') }}
                    {{ form_widget(form.latitude, {'attr': {'class':'cyber-input'}}) }}
                    {{ form_errors(form.latitude) }}
                </div>
            </div>
            <div style="flex:1; min-width:140px;">
                <div class="form-field">
                    {{ form_label(form.longitude, 'Longitude') }}
                    {{ form_widget(form.longitude, {'attr': {'class':'cyber-input'}}) }}
                    {{ form_errors(form.longitude) }}
                </div>
            </div>
        </div>
        <div class="form-field">
            {{ form_label(form.dateSoiree, 'Date et heure de la soirée') }}
            {{ form_widget(form.dateSoiree, {'attr': {'class':'cyber-input'}}) }}
            {{ form_errors(form.dateSoiree) }}
        </div>
        <div class="form-field">
            {{ form_label(form.nombrePlaces, 'Nombre total de places') }}
            {{ form_widget(form.nombrePlaces, {'attr': {'class':'cyber-input'}}) }}
            {{ form_errors(form.nombrePlaces) }}
        </div>
        <div style="text-align:center; margin-top:10px;">
            <button type="submit" class="btn-cyberpunk">Créer le jeu</button>
        </div>
        {{ form_end(form) }}
    </div>

    <hr style="width: 80%; border: 1px dashed var(--neon-blue); margin: 30px auto;">

    <h2 style="color:var(--neon-purple); text-align:center; margin-bottom:20px; font-size:1.8em">Accès aux listes de gestion</h2>
    
    <div class="actions" style="max-width: 900px; width: 100%; margin: 0 auto;">

        <a href="{{ path('app_game_index') }}" class="btn-cyberpunk" style="flex: 1; min-width: 250px; text-align: center">
            <span style="font-size: 1.2em;">Tous les jeux</span>
        </a>
        
        <a href="{{ path('admin_my_games') }}" class="btn-cyberpunk" style="flex: 1; min-width: 250px; text-align: center">
            <span style="font-size: 1.2em;">Vos Jeux</span>
        </a>

        <a href="{{ path('available_games') }}" class="btn-cyberpunk" style="flex: 1; min-width: 250px; text-align: center">
            <span style="font-size: 1.2em;">Inscription Jeu</span>
        </a>

        <a href="{{ path('admin_users_list') }}" class="btn-cyberpunk" style="flex: 1; min-width: 250px; text-align: center">
            <span style="font-size: 1.2em;">Utilisateurs</span>
        </a>

    </div>
    
</div>
{% endblock %}