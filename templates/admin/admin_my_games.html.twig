{% extends 'base.html.twig' %}
{% block title %}Admin | Vos Jeux Créés{% endblock %}
{% block body %}
<div class="dashboard-wrap">
    <div class="header-row">
        <h1 style="color:var(--neon-blue);">Vos Jeux Créés</h1>
    </div>

    <div class="cyber-card" style="margin-top:20px;">
        <table class="cyber-table" role="table" aria-label="Liste des jeux créés par l'admin">
            <thead>
                <tr>
                    <th style="text-align:center">Nom</th>
                    <th style="text-align:center">Ville</th>
                    <th style="text-align:center">Date et heure</th>
                    <th style="text-align:center">Places disponibles</th>
                    <th style="text-align:center">Participants</th>
                    <th style="text-align:center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for jeu in jeux_crees %}
                    <tr class="cyber-row">
                        <td data-label="Nom" style="text-align:center">{{ jeu.titre }}</td>
                        <td data-label="Ville" style="text-align:center">{{ jeu.ville }}</td>
                        <td data-label="Date et heure" style="text-align:center">{{ jeu.dateSoiree ? jeu.dateSoiree|date('d/m/Y H:i') : '' }}</td>
                        <td data-label="Places disponibles" style="text-align:center">
                            {{ jeu.getNombrePlacesRestantes() }} / {{ jeu.nombrePlaces }}
                        </td>
                        <td data-label="Participants" style="text-align:center">
                            {% if jeu.participants|length > 0 %}
                                <ul style="list-style-type: none; padding: 0; margin: 0;">
                            {% for participant in jeu.participants %}
                                <li>
                                    {{ participant.username }}
                                    
                                    {% if participant == jeu.user %}
                                        <span>(créateur)</span>
                                
                                    {% elseif participant == app.user %}
                                        <span>(Moi)</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                                </ul>
                            {% else %}
                            Aucun participant (seulement l'organisateur).
                            {% endif %}
                         </td>
                        <td data-label="Actions" class="actions-cell">
                            <div style="display:flex; justify-content:center; gap:10px;">
                                <a href="{{ path('app_game_show', {'id': jeu.id}) }}" class="btn-cyberpunk" style="padding:6px 10px;">Voir</a>
                                <a href="{{ path('app_game_edit', {'id': jeu.id}) }}" class="btn-cyberpunk" style="padding:6px 10px;">Modifier</a>
                                <form action="{{ path('app_game_delete', {'id': jeu.id}) }}" method="post" onsubmit="return confirm('Supprimer ce jeu ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ jeu.id) }}">
                                    <button type="submit" class="btn-cyberpunk">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr class="cyber-row">
                        <td colspan="5" style="text-align:center; padding:18px;">Aucun jeu créé pour le moment.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}