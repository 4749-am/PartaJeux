<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}PartaJeux — Soirées jeux{% endblock %}</title>

  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <link rel="stylesheet" href="{{ asset('css/style.css') }}?v={{ 'now'|date('U') }}">
  {% block extra_head %}{% endblock %}
</head>
<body class="{% if app.request.cookies.get('theme') == 'light' %}light{% endif %}">

  <header role="banner">
    <div class="logo-area">
      <a href="{{ path('app_home') }}" aria-label="PartaJeux, retour à l'accueil" style="text-decoration:none">
        <div class="logo">PJ</div>
        <div class="app-name">PartaJeux</div>
      </a>
    </div>

  <button class="burger-btn" id="burgerBtn" aria-label="ouvrir le menu de navigation">☰</button>

  <nav id="mobileMenu" role="navigation" aria-label="Menu principal">

    <div class="header-right">
      <a href="{{ path('app_home') }}" class="btn-cyberpunk mobile-home-btn" aria-label="Retour à l'accueil">Accueil</a>
      <a href="{{ path('app_contact') }}" class="btn-cyberpunk">Contact</a>
      {% if app.user %}
        <a href="{% if 'ROLE_ADMIN' in app.user.roles %}{{ path('admin_dashboard') }}{% else %}{{ path('user_dashboard') }}{% endif %}" class="btn-cyberpunk" style="width: 100%" aria-label="Retour à l'accueil du tableau de bord">Mon compte</a>
        <a href="{{ path('app_logout') }}" class="btn-cyberpunk" style="width: 100%" aria-label="Se déconnecter de son compte PartaJeux">Déconnexion</a>
      {% else %}
        <a href="{{ path('app_login') }}" class="btn-cyberpunk" style="width: 100%" aria-label="S'inscrire ou se connecter à son compte PartaJeux">S'inscrire / Se connecter</a>
      {% endif %}
    </div>
  </nav>
  </header>

  <main role="main">
    {% block body %}{% endblock %}
  </main>

  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="flash-{{ label }}" style="margin:10px;padding:8px;border-radius:8px;background:rgba(255,255,255,0.1);">
        {{ message }}
      </div>
    {% endfor %}
  {% endfor %}


  <footer role="contentinfo" id="footer">
    © {{ "now"|date("Y") }} PartaJeux — Tous droits réservés | <a href="#" style="text-decoration:none; color:var(--neon-blue)">Mentions légales</a>
  </footer>

  {% block extra_scripts %}

{% endblock %}

<script>

document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.querySelector("#searchInput");
    if (searchInput) {
        searchInput.addEventListener("input", (e) => {
            const filter = e.target.value.toLowerCase();

            document.querySelectorAll("table.cyber-table tbody tr").forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? "" : "none";
            });
        });
    }
});


document.getElementById("burgerBtn").addEventListener("click", () => {
    document.getElementById("mobileMenu").classList.toggle("open");
});

</script>
</body>
</html>
