{% extends 'base.html.twig' %}
{% block title %}Jeux{% endblock %}
{% block body %}
<h1>Liste des jeux</h1>
<table class="cyber-table">
    <thead>
        <tr>
            <th style="text-align:center">Id</th>
            <th style="text-align:center">Nom du jeu</th>
            <th style="text-align:center">Description</th>
            <th style="text-align:center">Ville</th>
            <th style="text-align:center">Date et heure</th>
            <th style="text-align:center">Latitude</th>
            <th style="text-align:center">Longitude</th>
            <th style="text-align:center">Places disponibles</th>
            <th style="text-align:center">Participants</th>
            <th style="text-align:center">Créé par</th>
            <th style="text-align:center">Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for jeu in jeux %}
        <tr>
            <td data-label="Id" style="text-align:center">{{ jeu.id }}</td>
            <td data-label="Nom du jeu" style="text-align:center">{{ jeu.titre }}</td>
            <td data-label="Description" style="text-align:center">{{ jeu.description }}</td>
            <td data-label="Ville" style="text-align:center">{{ jeu.ville }}</td>
            <td data-label="Date et heure" style="text-align:center">{{ jeu.dateSoiree ? jeu.dateSoiree|date('d/m/Y H:i') : '' }}</td>
            <td data-label="Latitude" style="text-align:center">{{ jeu.latitude|number_format(6) }}</td>
            <td data-label="Longitude" style="text-align:center">{{ jeu.longitude|number_format(6) }}</td>
            <td data-label="Places disponibles" style="text-align:center"><span>{{ jeu.getNombrePlacesRestantes() }} / {{ jeu.nombrePlaces }}</span></td>
            <td data-label="Participants" style="text-align:center">
                            {% if jeu.participants|length > 0 %}
                                <ul style="list-style-type: none; padding: 0; margin: 0;">
                            {% for participant in jeu.participants %}
                                <li>
                                    {{ participant.username }}
                                    
                                    {% if participant == jeu.user %}
                                        <span>(créateur)</span>
                                
                                    {% elseif participant == app.user %}
                                        <span>(Moi)</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                                </ul>
                            {% else %}
                            Aucun participant (seulement l'organisateur).
                            {% endif %}
            </td>
            <td data-label="Créé par" style="text-align:center">{{ jeu.user.username }}</td>
            <td data-label="Actions" class="actions-cell">
                <div style="display:flex; justify-content:center; gap:10px;">
                    <a href="{{ path('app_game_show', {'id': jeu.id}) }}" class="btn-cyberpunk">Voir</a>
                    <a href="{{ path('app_game_edit', {'id': jeu.id}) }}" class="btn-cyberpunk">Modifier</a>
                    <form action="{{ path('app_game_delete', {'id': jeu.id}) }}" method="post" onsubmit="return confirm('Supprimer ce jeu ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ jeu.id) }}">
                        <button type="submit" class="btn-cyberpunk" style="font-size:1em">Supprimer</button>
                    </form>
                </div>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="10" style="text-align:center;">Aucun jeu trouvé</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
<h1>Carte des jeux</h1>
<div id="map" style="height: 400px;"></div>
<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-o9N1jRVvG8k3uLw3hPtEgwXJ9vZlwJ2j1dCtmD12CM0="
    crossorigin=""
></script>
<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-o9N1jRVvG8k3uLw3hPtEgwXJ9vZlwJ2j1dCtmD12CM0="
    crossorigin=""
/>
<script>
    const map = L.map('map').setView([46.603354, 1.888334], 6); // centre France
    // Fond clair
    const lightTiles = L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
    attribution: '© OpenStreetMap contributors'
    }).addTo(map);
    // Marqueur néon purple
    const neonPurpleIcon = L.divIcon({
        html: `<svg xmlns="http://www.w3.org/2000/svg" width="30" height="40" viewBox="0 0 30 40">
                  <path d="M15 0C7 0 0 7 0 15c0 10 15 25 15 25s15-15 15-25C30 7 23 0 15 0z" fill="#9b59b6" stroke="white" stroke-width="1"/>
               </svg>`,
        className: "neon-marker",
        iconAnchor: [15, 40]
    });
    // Effet glow
    const style = document.createElement("style");
    style.textContent = `
      .neon-marker svg{
        filter: drop-shadow(0 0 6px #9b59b6) drop-shadow(0 0 12px #9b59b6);
      }
    `;
    document.head.appendChild(style);
    // Ajout des marqueurs et popup complet
    {% for jeu in jeux %}
        {% if jeu.latitude and jeu.longitude %}
            const marker{{ jeu.id }} = L.marker([{{ jeu.latitude }}, {{ jeu.longitude }}], {icon: neonPurpleIcon}).addTo(map);
            marker{{ jeu.id }}.bindPopup(`
                <b>{{ jeu.titre }}</b><br>
                {{ jeu.description }}<br>
                <b>Ville:</b> {{ jeu.ville }}<br>
                <b>Date et heure:</b> {{ jeu.dateSoiree ? jeu.dateSoiree|date('d/m/Y H:i') : '' }}<br>
                <b>Latitude:</b> {{ jeu.latitude|number_format(6) }}<br>
                <b>Longitude:</b> {{ jeu.longitude|number_format(6) }}<br>
                <b>Places disponibles:</b>{{ jeu.getNombrePlacesRestantes() }} / {{ jeu.nombrePlaces }}<br>
                <b>Créé par:</b> {{ jeu.user.username }}
            `);
        {% endif %}
    {% endfor %}
</script>
<a href="{{ path('app_game_new') }}" class="btn-cyberpunk" style="margin-top:20px; display:inline-block;">Créer un nouveau jeu</a>
{% endblock %}
