{% extends 'base.html.twig' %}
{% block title %}Jeux Disponibles{% endblock %}
{% block body %}
<div class="dashboard-wrap">
    <div class="header-row">
        <h1>Jeux disponibles pour inscription</h1>
        
        <p style="color:var(--neon-blue); font-weight:bold; font-size:1.2em; margin-top:30px">Filtrer les jeux par titre ou ville</p>
    </div>

    
    <div class="cyber-card" style="
        max-width: 1000px; 
        margin: 0 auto 20px auto;
        background: none !important; 
        border: none !important; 
        box-shadow: none !important;
        padding: 0; 
        
        --corner-size: 0px !important;
        --border-width: 0px !important;
        overflow: hidden; 
    ">
        <div class="search-bar-list" role="search">
            <label for="listSearchInput" class="visually-hidden">Rechercher un jeu ou une ville</label>
            <input 
                type="text" 
                id="listSearchInput" 
                placeholder="Rechercher dans la liste des jeux disponibles..." 
                aria-label="Rechercher dans la liste des jeux" 
                class="cyber-input" 
                style="width: 100%; border-color: var(--neon-purple); text-align: center; padding-left: 15px">
        </div>
    </div>
    
    
   
    <div class="cyber-card" style="max-width: 1000px; margin: 0 auto;">
        
        <table class="cyber-table" id="gameListTable">
            <thead>
                <tr>
                    <th style="text-align:center">Nom</th>
                    <th style="text-align:center">Ville</th>
                    <th style="text-align:center">Date et heure</th>
                    <th style="text-align:center">Places disponibles</th>
                    <th style="text-align:center">Participants</th>
                    <th style="text-align:center">Créé par</th>
                    <th style="text-align:center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for jeu in autresJeux %}
                    
                    <tr class="game-row">
                        <td data-label="Nom" style="text-align:center">{{ jeu.titre }}</td>
                        <td data-label="Ville" style="text-align:center">{{ jeu.ville }}</td>
                        <td data-label="Date et heure" style="text-align:center">{{ jeu.dateSoiree ? jeu.dateSoiree|date('d/m/Y H:i') : '' }}</td>
                        <td data-label="Places disponibles" style="text-align:center">{{ jeu.getNombrePlacesRestantes() }} / {{ jeu.nombrePlaces }}</td>
                        <td data-label="Participants" style="text-align:center">
                            {% if jeu.participants|length > 0 %}
                                <ul style="list-style-type: none; padding: 0; margin: 0;">
                            {% for participant in jeu.participants %}
                                <li>
                                    {{ participant.username }}
                                    
                                    {% if participant == jeu.user %}
                                        <span>(créateur)</span>
                                
                                    {% elseif participant == app.user %}
                                        <span>(Moi)</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                                </ul>
                            {% else %}
                            Aucun participant (seulement l'organisateur).
                            {% endif %}
                         </td>
                        <td data-label="Créé par" style="text-align:center">{{ jeu.user.username }}</td>
                        <td data-label="Actions" class="actions-cell" style="text-align:center">
                            {% if app.user %}
                                {% if jeu.participants.contains(app.user) %}
                                    <form action="{{ path('app_game_leave', {'id': jeu.id}) }}" method="post" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('leave' ~ jeu.id) }}">
                                        <button type="submit" class="btn-cyberpunk">
                                            Se désinscrire
                                        </button>
                                    </form>
                                {% else %}
                                    <form action="{{ path('app_game_join', {'id': jeu.id}) }}" method="post" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('join' ~ jeu.id) }}">
                                        <button type="submit" class="btn-cyberpunk" {{ jeu.getNombrePlacesRestantes() == 0 ? 'disabled' : '' }}>
                                            S'inscrire
                                        </button>
                                    </form>
                                {% endif %}
                            {% else %}
                                <a href="{{ path('app_login') }}" class="btn-cyberpunk">Se connecter</a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" style="text-align:center;">Aucun autre jeu disponible pour le moment.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", () => {
    
    const searchInput = document.getElementById('listSearchInput');
    const tableRows = document.querySelectorAll('#gameListTable .game-row'); 

    if (searchInput) {
        searchInput.addEventListener('input', () => {
            
            const value = searchInput.value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, ""); 
            
            tableRows.forEach(row => {
                
                const rowText = row.textContent.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
                
                row.style.display = rowText.includes(value) ? '' : 'none';
            });
        });
    }
});
</script>

{% endblock %}