{% extends 'base.html.twig' %}
{% block title %}Gestion Utilisateurs{% endblock %}
{% block body %}
<div class="dashboard-wrap">
    <div class="header-row">
        <h1>Gestion des Utilisateurs</h1>
    </div>

    <div class="cyber-card">
        <table class="cyber-table">
            <thead>
                <tr>
                    <th style="text-align:center">Utilisateur</th>
                    <th style="text-align:center">Email</th>
                    <th style="text-align:center">Statut</th>
                    <th style="text-align:center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for u in utilisateurs %}
                    <tr>
                        <td data-label="Utilisateur" style="text-align:center">{{ u.username }}</td>
                        <td data-label="Email" style="text-align:center">{{ u.email }}</td>
                        <td data-label="Statut" style="text-align:center">
                            {% if u.isBanned %}
                                <span style="color:#ff1a5e; font-weight:bold">Banni</span>
                            {% else %}
                                <span style="color:#00ff88; font-weight:bold">Actif</span>
                            {% endif %}
                        </td>
                        <td data-label="Actions" class="actions-cell">
                            {% if 'ROLE_ADMIN' in u.roles %}
                                <span style="color:#a0a0a0; font-weight:bold">ADMIN PROTEGE</span>
                            {% else %}
                                {% if u.isBanned %}
                                    <a href="{{ path('user_unban', {id: u.id}) }}" class="btn-cyberpunk user-ban-button">Débannir</a>
                                {% else %}
                                    <a href="{{ path('user_ban', {id: u.id}) }}" class="btn-cyberpunk user-ban-button">
                                        Bannir
                                    </a>
                                {% endif %}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}